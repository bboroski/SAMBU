# Opt-in type annotations and gradual checks in SAMBU.

let observations: Array<Number> = [12, 18, 21, 24]

fn average(values: Array<Number>) -> Number {
    return sum(values) / count(values)
}

fn label(value: String) -> String {
    return value
}

let mean_value: Number = average(observations)
print(mean_value)
print(label("mean"))
