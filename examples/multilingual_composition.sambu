# Neutral synthetic multilingual text-analysis fixture.
let draft = "[Verse 1]\\nНалаштування профілю доступні\\n[Chorus]\\nSystem status is ready\\n[Куплет 2]\\nEnglish and українські labels\\n[Припев]\\nSystem status is ready"

let structure = text_structure_profile(draft)
let languages = language_mix_profile(draft)
let sound = prosody_profile(draft)

print("Sections:")
print(structure.section_count)
print("Repeated blocks:")
print(structure.refrain_groups[0].repeat_count)
print("Latin/Cyrillic switch lines:")
print(languages.code_switch_line_count)
print("Estimated syllables:")
print(sound.syllable_counts)
