# Finite ensembles, reversible relaxation and pure dephasing in SAMBU.
let levels = [0 * J, 1e-21 * J, 2e-21 * J]
let temperature = 300 * K

let canonical = canonical_ensemble(levels, temperature)
print(canonical.partition_relative)
print(canonical.mean_energy)
print(canonical.entropy_nats)

let microcanonical = microcanonical_ensemble(levels, 1e-21 * J, 0 * J)
print(microcanonical.degeneracy)

let evolved = markov_relaxation(levels, [1, 0, 0], temperature, 2 * Hz, 0.5 * s)
print(evolved.populations)
print(evolved.relaxation_factor)

let density = lindblad_dephase([[0.5, 0.2], [0.2, 0.5]], 1 * Hz, 2 * s)
print(density.matrix)
print(density.purity)

let transport = onsager_flux([3, 4], [[2, 0], [0, 1]])
print(transport.fluxes)
print(transport.entropy_production)

print(phonon_decay(1, 3 * Hz, 1 * s))
print(planck_time())
