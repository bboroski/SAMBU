# Comparative, parameterized Anatidae-inspired model collection.
# Every coefficient is illustrative input, never a universal duck constant.

let limb = countercurrent_exchange(310 * K, 280 * K, 75%)
let feathers = feather_barrier_profile(1, 90%, 80%, 10%, 20%)
let flight = flight_energy_budget((10 * J) / (1 * s), 5 * s, 60 * J)
let muscles = flight_muscle_profile((8 * J) / (1 * s), (2 * J) / (1 * s), 5 * s, 75%)
let speed = migration_speed(150 * km, 10800 * s)
let oxygen = avian_gas_exchange(100, 21%, 40%, 20 * Pa)
let air_cycle = avian_air_sac_cycle(100, 9, 80%)
let bill = bill_lamella_filter(2, 0.5, 100)
let salt = salt_balance(20, 5, 16)
let flock = flock_flight_budget((10 * J) / (1 * s), 10 * s, 12, 2, 20%)
let eyes = visual_system_profile(330, 0.8, true, true)
let imprint = imprinting_window(14, 12, 16)
let sleep = hemispheric_sleep_budget(20, 10%, 100%)
let heading = magnetic_heading(5, 12, 50%)
let digestion = digestive_grinding(10, 20%, 3)

print(limb.venous_return)
print(feathers.effective_insulation_index)
print(flight.energy_required)
print(muscles.fat_oxidation_energy_estimate)
print(speed)
print(oxygen.oxygen_uptake_proxy)
print(air_cycle.phase_count)
print(bill.retention_fraction)
print(salt.net_salt_balance_rate)
print(flock.relative_saving)
print(eyes.panoramic_fraction)
print(imprint.inside_configured_window)
print(sleep.edge_bird_count_estimate)
print(heading.corrected_heading_degrees)
print(digestion.estimated_particle_size)
