# Deterministic batch-scaling fixture. The path remains for CI compatibility.

fn scale_quantity(value, source_units, target_units) {
  return value * target_units / source_units
}

fn aggregate_components(component_a, component_b) {
  return component_a + component_b
}

fn aggregate_total(core, aggregate, auxiliary) {
  return core + aggregate + auxiliary
}

let source_units = 8
let target_units = 12

let quantity_a = scale_quantity(180, source_units, target_units)
let quantity_b = scale_quantity(90, source_units, target_units)
let quantity_c = scale_quantity(120, source_units, target_units)
let quantity_d = scale_quantity(3, source_units, target_units)

let component_a = scale_quantity(260, source_units, target_units)
let component_b = scale_quantity(180, source_units, target_units)
let aggregate = aggregate_components(component_a, component_b)

let core = quantity_a + quantity_b + quantity_c
let auxiliary = scale_quantity(40, source_units, target_units)
let total = aggregate_total(core, aggregate, auxiliary)
let unit_value = total / target_units

print("SAMBU Mulberry Charlotte")
print(target_units)
print(quantity_a)
print(quantity_b)
print(quantity_c)
print(quantity_d)
print(component_a)
print(component_b)
print(total)
print(unit_value)
