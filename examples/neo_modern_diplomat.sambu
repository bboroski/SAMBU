# Neo-Modern Diplomat: model a stakeholder network and a negotiation zone.
# The model describes influence paths and bargaining ranges; it does not
# predict real diplomatic outcomes.

let stakeholders = ["community", "studio", "teachers", "partners", "media"]
let relations = [
  ["studio", "community", 0.9],
  ["teachers", "community", 0.8],
  ["studio", "teachers", 0.7],
  ["partners", "studio", 0.6],
  ["media", "community", 0.5]
]

let ecosystem = network(stakeholders, relations)
let topology = network_metrics(ecosystem)
let reach = influence(ecosystem, ["studio"], 3, 0.85)

print("Stakeholder network:")
print(topology)
print("Influence reach by node:")
for i in range(count(stakeholders)) {
  print(stakeholders[i])
  print(reach.scores[i])
}

# Overlap between the studio's offer and a partner's acceptable range.
let zone = negotiate(25, 40, 32, 50)
if (zone.possible) {
  print("A bargaining interval exists:")
  print(zone.lower)
  print(zone.upper)
  print(zone.midpoint)
} else {
  print("No bargaining overlap; revise the proposal.")
}
