#version 450
// One invocation per occupied voxel. The output is a six-bit mask:
// +X, -X, +Y, -Y, +Z, -Z. Empty neighbours are exposed faces.
// This pass compacts visibility metadata; a later pass can prefix-sum masks
// and emit mesh vertices/indices without CPU readback.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(r32ui, set = 0, binding = 0) uniform readonly uimage3D occupancy;
layout(std430, set = 0, binding = 1) readonly buffer ActiveCells {
    uvec2 cells[]; // x = packed local xyz uint8, y = material uint16 in low bits
};
layout(std430, set = 0, binding = 2) writeonly buffer VisibleFaces {
    uint faceMasks[];
};
layout(push_constant) uniform VoxelParams {
    uvec3 dimensions;
    uint cellCount;
} params;
bool is_empty(ivec3 p) {
    if (any(lessThan(p, ivec3(0))) || any(greaterThanEqual(p, ivec3(params.dimensions)))) return true;
    return imageLoad(occupancy, p).r == 0u;
}
void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= params.cellCount) return;
    uint packed = cells[index].x;
    ivec3 p = ivec3(
        int(packed & 255u),
        int((packed >> 8u) & 255u),
        int((packed >> 16u) & 255u)
    );
    uint mask = 0u;
    if (is_empty(p + ivec3( 1, 0, 0))) mask |= 1u << 0;
    if (is_empty(p + ivec3(-1, 0, 0))) mask |= 1u << 1;
    if (is_empty(p + ivec3( 0, 1, 0))) mask |= 1u << 2;
    if (is_empty(p + ivec3( 0,-1, 0))) mask |= 1u << 3;
    if (is_empty(p + ivec3( 0, 0, 1))) mask |= 1u << 4;
    if (is_empty(p + ivec3( 0, 0,-1))) mask |= 1u << 5;
    faceMasks[index] = mask;
}
