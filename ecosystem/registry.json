        "sambu-language-runtime",
        "developer-tooling",
        "architecture-models",
        "policy-and-workflow-descriptions",
        "module-manifest-v1",
        "ecosystem-registry-v1",
        "unicode-script-profiling-v1",
        "multilingual-signal-metadata-v1"
      ],
      "consumes": [
        "sambu-module-manifest-v1",
        "versioned-adapter-descriptors",
        "evidence-reports"
      ]
    },
    {
      "id": "kloz-platform",
      "repository": "bboroski/Kloz",
      "role": "freestanding-platform-substrate",
      "runtime": [
