  "edges": [
    {
      "from": "sambu-core",
      "to": "kloz-platform",
      "kind": "architecture-contract",
      "status": "defined",
      "scope": "Manifest, role and evidence contract; no Python runtime linkage."
    },
    {
      "from": "sambu-core",
      "to": "co-lifecycle",
      "kind": "architecture-contract",
      "status": "defined",
      "scope": "Workflow and lifecycle concepts remain separate from the native C implementation."
    },
    {
      "from": "sambu-core",
      "to": "saintsi-assurance",
      "kind": "architecture-contract",
      "status": "defined",
      "scope": "Policy descriptions and assurance evidence; no automatic watchdog authority."
    },
    {
      "from": "sambu-core",
      "to": "reapercripple-hardware",
      "kind": "architecture-contract",
      "status": "defined",
      "scope": "Production profile metadata and evidence boundaries; physical validation stays with target fixtures."
    },
    {
      "from": "sambu-core",
      "to": "toolng-diagnostics",
      "kind": "native-policy-port",
      "status": "implemented",
      "scope": "Selected engineering rules are ported to C17; no Python interpreter is embedded."
    },
    {
      "from": "sambu-core",
      "to": "klipot-control-plane",
      "kind": "registry-projection",
      "status": "mirrored",
      "scope": "Klipot displays a mirror of the canonical registry and keeps no firmware dependency."
    },
    {
      "from": "kloz-platform",
      "to": "co-lifecycle",
      "kind": "optional-platform-adapter",
      "status": "defined",
      "scope": "Future application-owned context composition; the current CO platform header reports target facts but no direct Kloz adapter header is present."
    },
    {
      "from": "kloz-platform",
      "to": "saintsi-assurance",
      "kind": "optional-clock-adapter",
      "status": "adapter-ready",
      "scope": "Clock bridge is optional; tick units and rollover intervals belong to the integrator."
    },
    {
      "from": "kloz-platform",
      "to": "reapercripple-hardware",
      "kind": "optional-bsp-adapter",
      "status": "adapter-ready",
      "scope": "Board-specific BSP and safety callbacks remain authoritative."
    },
    {
      "from": "co-lifecycle",
      "to": "saintsi-assurance",
      "kind": "optional-heartbeat-adapter",
      "status": "adapter-ready",
      "scope": "Refresh only after a successful completed poll."
    },
    {
      "from": "saintsi-assurance",
      "to": "reapercripple-hardware",
      "kind": "optional-health-observation",
      "status": "adapter-ready",
      "scope": "Observation informs policy; it never authorizes an actuator or reset."
    },
    {
      "from": "sambu-core",
      "to": "jungelist-massive-coordinator",
      "kind": "federation-coordination-contract",
      "status": "defined",
      "scope": "Jungelist Massive coordinates cross-project proposals and language-foundry research; SAMBU retains authority over canonical module schema and registry semantics. No runtime dependency."
    },
    {
      "from": "kloz-platform",
      "to": "nun-kernel",
      "kind": "submodule-platform-contract",
      "status": "mirrored",
      "scope": "Pinned source submodule; target-specific kernel integration remains subject to NUN build and target validation."
    },
    {
      "from": "co-lifecycle",
      "to": "nun-kernel",
      "kind": "submodule-lifecycle-contract",
      "status": "mirrored",
      "scope": "Pinned source submodule; not an RTOS and not proof of linked runtime integration."
    },
    {
      "from": "saintsi-assurance",
      "to": "nun-kernel",
      "kind": "submodule-observation-contract",
      "status": "mirrored",
      "scope": "Pinned source submodule; observation only and no watchdog actuation."
    },
    {
      "from": "reapercripple-hardware",
      "to": "nun-kernel",
      "kind": "submodule-platform-evidence-contract",
      "status": "mirrored",
      "scope": "Pinned source submodule; board-specific use requires exact target evidence."
    },
    {
      "from": "toolng-diagnostics",
      "to": "nun-kernel",
      "kind": "submodule-policy-contract",
      "status": "mirrored",
      "scope": "Policy semantics only; no desktop runtime or Python interpreter in the kernel image."
    },
    {
      "from": "sambu-core",
      "to": "nun-kernel",
      "kind": "host-metadata-contract",
      "status": "mirrored",
      "scope": "Manifest and host tooling conventions only; no SAMBU Python runtime in the kernel image."
    },
    {
      "from": "klipot-control-plane",
      "to": "nun-kernel",
      "kind": "metadata-projection-contract",
      "status": "mirrored",
      "scope": "Registry and operator documentation projection only; no browser runtime in the kernel image."
    },
    {
      "from": "nun-kernel",
      "to": "nunlauncher-admission",
      "kind": "kernel-image-admission-contract",
      "status": "adapter-ready",
      "scope": "NUNLauncher validates NUN image metadata before handoff; it does not execute or authenticate the image."
    },
    {
      "from": "sambu-core",
      "to": "luci-engineering-control-plane",
      "kind": "module-manifest-validation-contract",
      "status": "implemented",
      "scope": "Luci validates local SAMBU module metadata and policy references; no remote code execution."
    },
    {
      "from": "toolng-diagnostics",
      "to": "blopscore-hardware-inspection",
      "kind": "read-only-diagnostic-evidence-adapter",
      "status": "defined",
      "scope": "Planned compatibility only; BlopScore remains design-only and has no live device integration."
    },
    {
      "from": "co-lifecycle",
      "to": "reapercripple-hardware",
      "kind": "optional-lifecycle-adapter",
      "status": "defined",
      "scope": "Potential application-owned lifecycle composition; no direct ReaperCripple-to-CO adapter header is currently present."
    }
  ],
  "shared_contracts": {
    "multilingual_text_signal_v1": {
      "version": 1,
      "schema": "schemas/text-signal-envelope.schema.json",
      "specification": "docs/MULTILINGUAL_SIGNAL_PIPELINE.md",
      "metadata_only": true,
      "raw_text_embedded": false
    },
    "academic_biology_terms_v1": {
      "version": 1,
      "format": "UTF-8 TSV (tab-delimited)",
      "records": 500,
      "fields": [
        "id",
        "category",
        "term_en",
        "term_ru"
      ],
      "languages": [
        "en",
        "ru"
      ],
      "category_keys": [
        "molecular_cell",
        "genetics_evolution",
        "ecology_environment",
        "physiology_anatomy",
        "immunology_microbiology_virology"
      ],
      "canonical_dataset": "https://github.com/bboroski/SAMBU/blob/main/data/biology/academic_terms_500.tsv",
      "local_copy_path": "data/biology/academic_terms_500.tsv",
      "specification": "https://github.com/bboroski/SAMBU/blob/main/docs/BIOLOGY_DOMAIN_PACK.md",
      "validator": "tools/validate_biology_terms.py",
      "reference_only": true,
      "clinical_decision_support": false,
      "hardware_control": false
    }
  }
