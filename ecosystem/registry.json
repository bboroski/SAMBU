{
  "schema_version": 1,
  "ecosystem": "SAMBU",
  "canonical_source": "bboroski/SAMBU/ecosystem/registry.json",
  "manifest_schema": "bboroski/SAMBU/ecosystem/module.schema.json",
  "governance": {
    "principle": "Independent repositories integrate through versioned manifests, explicit adapters and testable evidence; no repository is absorbed into a monolith.",
    "runtime_rule": "SAMBU's Python runtime is not a dependency of freestanding C modules. ToolNG contains a native C17 policy port, not the Python interpreter.",
    "release_rule": "Each repository owns its releases and validation. Cross-repository compatibility is reported separately from local test status."
  },
  "modules": [
    {
      "id": "sambu-core",
      "repository": "bboroski/SAMBU",
      "role": "central-language-and-engineering-platform",
      "runtime": [
        "Python >=3.10"
      ],
      "maturity": "experimental-alpha",
      "manifest": "sambu.module.json",
