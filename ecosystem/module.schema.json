{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bboroski/SAMBU/blob/main/ecosystem/module.schema.json",
  "title": "SAMBU Ecosystem Module Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ecosystem",
    "module_id",
    "repository",
    "display_name",
    "role",
    "runtime",
    "maturity",
    "provides",
    "consumes",
    "dependencies",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ecosystem": {
      "const": "SAMBU"
    },
    "module_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "maturity": {
      "type": "string",
      "minLength": 1
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "consumes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module_id",
          "relation",
          "status",
          "scope"
        ],
        "properties": {
          "module_id": {
            "type": "string"
          },
          "relation": {
            "enum": [
              "required",
              "optional-adapter",
              "policy-port",
              "metadata-projection"
            ]
          },
          "status": {
            "enum": [
              "implemented",
              "adapter-ready",
              "planned",
              "mirrored"
            ]
          },
          "scope": {
            "type": "string"
          }
        }
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_tests",
        "target_validation"
      ],
      "properties": {
        "host_tests": {
          "type": "string"
        },
        "target_validation": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
