{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SAMBU",
  "scopeName": "source.sambu",
  "fileTypes": [
    "sambu"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#fortran_operators"
    },
    {
      "include": "#fortran_constants"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#logical"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.sambu",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.pascal",
          "match": "//.*$"
        },
        {
          "name": "comment.line.exclamation.fortran",
          "match": "!.*$"
        },
        {
          "name": "comment.block.curly.pascal",
          "begin": "\\{",
          "end": "\\}"
        },
        {
          "name": "comment.block.parenthesized-pascal",
          "begin": "\\(\\*",
          "end": "\\*\\)"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sambu",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.sambu",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.sambu",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.sambu",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.sambu",
          "match": "(?:\\b\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.sambu",
          "match": "\\b(fn|tava)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.sambu"
            },
            "2": {
              "name": "entity.name.function.sambu"
            }
          }
        },
        {
          "name": "meta.class.sambu",
          "match": "\\b(class|kaven)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.class.sambu"
            },
            "2": {
              "name": "entity.name.type.class.sambu"
            }
          }
        }
      ]
    },
    "keywords": {
      "name": "keyword.control.sambu",
      "match": "\\b(?:implementation|initialization|finalization|implements|subroutine|character|interface|precision|procedure|protected|published|recursive|abstract|contains|function|implicit|property|extends|integer|logical|private|program|double|downto|module|public|result|return|static|array|begin|class|const|final|kaven|kavir|kavum|keven|kevir|kevum|kiven|kivir|kivum|print|taven|tavir|tavum|teven|trait|write|call|else|kava|keva|kiva|kova|none|real|tava|teva|then|type|unit|uses|end|for|int|let|var|do|fn|if|in|to)\\b"
    },
    "logical": {
      "name": "keyword.operator.logical.sambu",
      "match": "\\b(?:and|or|not|rava|raven|ravir)\\b"
    },
    "constants": {
      "name": "constant.language.sambu",
      "match": "\\b(?:true|false|null|ravum|reva|reven)\\b"
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.sambu",
          "match": "\\b(?:hemispheric_sleep_budget|biometric_taxonomy_sort|countercurrent_exchange|feather_barrier_profile|voxel_spectral_profile|wetland_ecosystem_loop|flight_muscle_profile|oxygen_pressure_ratio|tic_tac_toe_best_move|visual_system_profile|accreditation_record|accreditation_status|flight_energy_budget|avian_air_sac_cycle|bill_lamella_filter|countercurrent_sync|flock_flight_budget|avian_gas_exchange|digestive_grinding|plumage_insulation|imprinting_window|percentage_points|reduce_by_percent|supervisor_status|tic_tac_toe_state|voxel_solve_field|magnetic_heading|percent_to_ratio|ratio_to_percent|tic_tac_toe_move|voxel_frame_plan|voxel_octree_get|channel_metrics|channel_receive|idempotency_key|imprint_closure|migration_speed|network_metrics|package_pricing|prosody_profile|v_vector_stream|weekly_schedule|mimic_distance|order_pipeline|percent_change|retry_schedule|sample_maxwell|thermal_energy|unit_economics|voxel_sparsify|apply_percent|audio_profile|capture_tower|clamp_percent|gift_transfer|mimic_profile|mine_patterns|queue_profile|signal_report|voxel_raycast|capture_node|channel_send|cluster_glue|coq_pipeline|parse_report|salt_balance|studio_offer|text_profile|voxel_chunks|voxel_export|voxel_octree|voxel_remove|actor_drain|actor_state|coq_explain|pitch_score|voxel_count|actor_send|attendance|blast_plan|coq_filter|gift_batch|percent_of|percentage|supervisor|voxel_grid|voxel_mesh|associate|boltzmann|coq_match|influence|negotiate|partition|rhyme_key|rps_round|supervise|syllables|voxel_get|voxel_set|word_info|allocate|coq_rule|variance|wordbook|ab_test|channel|entropy|maxwell|network|funnel|actor|count|daven|davir|davum|deven|devir|devum|koven|kovir|kovum|laven|lavir|lavum|leven|levir|levum|liven|livir|livum|maven|mavir|mavum|meven|mevir|mevum|miven|mivir|mivum|moven|naven|navir|navum|neven|nevir|nevum|niven|paven|pavir|pavum|peven|pevir|pevum|piven|pivir|pivum|poven|povir|print|range|revir|revum|riven|rivir|rivum|roven|rovir|saven|savir|savum|seven|sevir|sevum|siven|sivir|sivum|soven|sovir|sovum|tevir|tevum|tiven|tivir|tivum|toven|tovir|tovum|tuven|tuvir|tuvum|vaven|vavir|vavum|veven|vevir|vevum|viven|vivir|vivum|voven|vovir|vovum|vuven|dava|deva|diva|kuva|lava|leva|liva|lova|mava|mean|meva|miva|mova|nava|neva|niva|pava|peva|piva|pova|riva|rova|sava|seva|siva|sova|sqrt|suva|tiva|tova|tuva|vava|veva|viva|vova|vuva|abs|exp|len|log|max|min|sum)\\b(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.sambu",
      "match": ":=|<>|==|!=|<=|>=|&&|\\|\\||\\*\\*|[+*/%<>=!^-]"
    },
    "punctuation": {
      "name": "punctuation.separator.sambu",
      "match": "[()\\[\\]{}.,;]"
    },
    "fortran_operators": {
      "name": "keyword.operator.logical.fortran",
      "match": "\\.(?:and|or|not|eqv|neqv|eq|ne|lt|le|gt|ge)\\."
    },
    "fortran_constants": {
      "name": "constant.language.fortran",
      "match": "\\.(?:true|false)\\."
    }
  }
}
