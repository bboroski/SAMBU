{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bboroski/SAMBU/blob/main/schemas/creative-metadata.schema.json",
  "title": "SAMBU Creative Metadata Document",
  "description": "Metadata-only annotation contract. Raw creative source text is intentionally excluded.",
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster_id", "theme", "tone", "ontology_version"],
      "properties": {
        "cluster_id": {
          "type": "string",
          "enum": ["T-001", "T-002", "T-003", "T-004", "T-005", "T-006", "T-007", "T-008", "T-009"]
        },
        "theme": {"type": "string", "minLength": 1, "maxLength": 96},
        "tone": {"type": "string", "minLength": 1, "maxLength": 96},
        "key_symbols": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 80},
          "uniqueItems": true
        },
        "language": {
          "type": "array",
          "maxItems": 8,
          "items": {"type": "string", "minLength": 1, "maxLength": 16}
        },
        "linguistic_register": {"type": ["string", "null"], "maxLength": 96},
        "stylistic_devices": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 80},
          "uniqueItems": true
        },
        "safety_flag": {
          "type": "string",
          "enum": [
            "CLEAN",
            "CLEAN_SATIRE",
            "SANITIZED_ARGOT_ONLY",
            "SANITIZED_INTIMACY",
            "NEEDS_REVIEW",
            "EXCLUDED_FROM_GENERATION"
          ],
          "default": "NEEDS_REVIEW"
        },
        "source_ref": {"type": ["string", "null"], "maxLength": 128},
        "content_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "ontology_version": {"type": "string", "enum": ["2026.11", "2026.12"]},
        "review_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "dependentRequired": {
        "review_ref": ["reviewed_at"],
        "reviewed_at": ["review_ref"]
      },
      "allOf": [
        {
          "if": {"properties": {"cluster_id": {"const": "T-009"}}, "required": ["cluster_id"]},
          "then": {"properties": {"ontology_version": {"const": "2026.12"}}}
        }
      ]
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/record"},
    {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/record"}
    }
  ]
}
