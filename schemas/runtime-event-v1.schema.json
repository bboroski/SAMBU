{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bboroski/SAMBU/blob/main/schemas/runtime-event-v1.schema.json",
  "title": "SAMBU Runtime Event Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "producer",
    "event_type",
    "sequence",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "version"
      ],
      "properties": {
        "module_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "causation_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {
      "type": "object"
    }
  }
}
